<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>BLOOD HUNTERS - Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
</head>

<body class="dashboard-body">
    <div class="glass-bg"></div>

    <div class="main-container">
        <header class="hero-section">
            <div class="hero-content">
                <h1 class="hero-title">BLOOD HUNTERS</h1>
                <p class="hero-subtitle">The Ultimate Multi-Server Management Core</p>
                <div class="status-badge">
                    <span class="dot"></span> 🌐 System Online
                </div>
            </div>
        </header>

        <section class="server-grid-section">
            <div class="grid-header">
                <h2><i class="fas fa-server"></i> Your Controlled Servers</h2>
                <p>Select a server to configure its unique operations and intelligence.</p>
            </div>

            <div class="server-grid">
                <% guilds.forEach(guild=> { %>
                    <div class="server-card">
                        <div class="card-glow"></div>
                        <div class="server-icon-wrapper">
                            <img src="<%= guild.icon || 'https://cdn.discordapp.com/embed/avatars/0.png' %>"
                                alt="Guild Icon">
                        </div>
                        <div class="server-info">
                            <h3>
                                <%= guild.name %>
                            </h3>
                            <div class="server-stats">
                                <span class="stat total"><i class="fas fa-users"></i>
                                    <%= guild.memberCount %> Total
                                </span>
                                <span class="stat online"><i class="fas fa-circle stat-dot"></i>
                                    <%= guild.activeCount %> Online
                                </span>
                                <span class="stat offline"><i class="fas fa-circle stat-dot offline-dot"></i>
                                    <%= guild.offlineCount %> Offline
                                </span>
                            </div>
                        </div>
                        <a href="/settings/<%= guild.id %>" class="btn-manage">
                            <span>Manage Server</span> <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                    <% }); %>

                        <!-- Add Server Card -->
                        <div class="server-card add-card">
                            <div class="card-glow"></div>
                            <div class="server-icon-wrapper add-icon">
                                <i class="fas fa-plus"></i>
                            </div>
                            <div class="server-info">
                                <h3>Expand HUNTERS</h3>
                                <p>Invite the bot to a new server</p>
                            </div>
                            <a href="<%= inviteLink %>" target="_blank" class="btn-manage invite">
                                <span>Generate Invite</span> <i class="fas fa-external-link-alt"></i>
                            </a>
                        </div>
            </div>
        </section>
    </div>

    <style>
        .main-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 4rem 2rem;
        }

        .hero-section {
            text-align: center;
            margin-bottom: 6rem;
            animation: fadeInDown 1s ease-out;
        }

        .hero-title {
            font-size: 5rem;
            font-weight: 900;
            text-transform: uppercase;
            letter-spacing: -2px;
            background: linear-gradient(to bottom, #fff 0%, #444 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            margin-bottom: 0.5rem;
        }

        .hero-subtitle {
            color: var(--text-dim);
            font-size: 1.25rem;
            font-weight: 500;
            margin-bottom: 2rem;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            background: rgba(0, 255, 100, 0.1);
            color: #00ff64;
            padding: 0.6rem 1.5rem;
            border-radius: 100px;
            font-weight: 800;
            font-size: 0.9rem;
            border: 1px solid rgba(0, 255, 100, 0.2);
        }

        .status-badge .dot {
            width: 8px;
            height: 8px;
            background: #00ff64;
            border-radius: 50%;
            box-shadow: 0 0 10px #00ff64;
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.5);
                opacity: 0.5;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        .server-grid-section h2 {
            font-size: 2rem;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .server-grid-section p {
            color: var(--text-dim);
            margin-bottom: 3rem;
        }

        .server-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
            gap: 2.5rem;
        }

        .server-card {
            background: var(--card-bg);
            border: 1px solid var(--border-light);
            padding: 3rem 2rem;
            border-radius: 32px;
            text-align: center;
            position: relative;
            overflow: hidden;
            backdrop-filter: var(--glass-blur);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .server-card:hover {
            transform: translateY(-15px) scale(1.02);
            border-color: var(--primary);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 30px rgba(var(--primary-rgb), 0.1);
        }

        .card-glow {
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle at 50% 50%, rgba(var(--primary-rgb), 0.05) 0%, transparent 50%);
            opacity: 0;
            transition: opacity 0.4s ease;
            pointer-events: none;
        }

        .server-card:hover .card-glow {
            opacity: 1;
        }

        .server-icon-wrapper {
            width: 100px;
            height: 100px;
            margin-bottom: 2rem;
            position: relative;
        }

        .server-icon-wrapper img {
            width: 100%;
            height: 100%;
            border-radius: 28px;
            object-fit: cover;
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.3);
        }

        .add-icon {
            background: rgba(255, 255, 255, 0.05);
            border: 2px dashed var(--border-light);
            border-radius: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            color: var(--text-dim);
        }

        .server-info h3 {
            font-size: 1.5rem;
            font-weight: 800;
            margin-bottom: 0.8rem;
        }

        .server-stats {
            display: flex;
            justify-content: center;
            gap: 10px;
            margin-bottom: 2.5rem;
            flex-wrap: wrap;
        }

        .stat {
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 12px;
            border-radius: 12px;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--text-dim);
            display: flex;
            align-items: center;
            gap: 6px;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .stat.online {
            color: #fff;
            border-color: rgba(0, 255, 100, 0.2);
            background: rgba(0, 255, 100, 0.05);
        }

        .stat.total {
            color: #fff;
            border-color: rgba(255, 255, 255, 0.1);
        }

        .stat-dot {
            font-size: 0.55rem;
            color: #00ff64;
            box-shadow: 0 0 8px rgba(0, 255, 100, 0.5);
            border-radius: 50%;
        }

        .stat-dot.offline-dot {
            color: #747f8d;
            box-shadow: none;
        }

        .btn-manage {
            width: 100%;
            background: var(--glass);
            color: #fff;
            text-decoration: none;
            padding: 1.2rem;
            border-radius: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: 1px solid var(--border-light);
            transition: all 0.3s ease;
        }

        .server-card:hover .btn-manage {
            background: var(--primary);
            border-color: var(--primary);
            box-shadow: 0 10px 20px rgba(var(--primary-rgb), 0.3);
        }

        .btn-manage.invite {
            background: rgba(0, 242, 255, 0.1);
            border-color: rgba(0, 242, 255, 0.2);
            color: var(--accent);
        }

        .server-card:hover .btn-manage.invite {
            background: var(--accent);
            border-color: var(--accent);
            color: #000;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-50px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
</body>

</html>